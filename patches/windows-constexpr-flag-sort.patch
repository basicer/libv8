--- a/src/flags/flags.cc
+++ b/src/flags/flags.cc
@@ -440,10 +440,27 @@
   for (size_t i = 0; i < kNumAllFlags; ++i) {
     indices[i] = static_cast<int>(i);
   }
-  std::sort(indices.begin(), indices.end(), [](int i, int j) {
+  auto less = [](int i, int j) {
     return FlagHelpers::FlagNamesCmp(kFlagsMetadata[i].name,
                                      kFlagsMetadata[j].name) < 0;
-  });
+  };
+  auto sift = [&](size_t root, size_t count) {
+    for (size_t child = (2 * root) + 1; child < count; child = (2 * root) + 1) {
+      if (child + 1 < count && less(indices[child], indices[child + 1])) ++child;
+      if (!less(indices[root], indices[child])) return;
+      const int tmp = indices[root];
+      indices[root] = indices[child];
+      indices[child] = tmp;
+      root = child;
+    }
+  };
+  for (size_t i = kNumAllFlags / 2; i-- > 0;) sift(i, kNumAllFlags);
+  for (size_t end = kNumAllFlags; end-- > 1;) {
+    const int tmp = indices[0];
+    indices[0] = indices[end];
+    indices[end] = tmp;
+    sift(0, end);
+  }
   return indices;
 }();
 
