--- a/src/sandbox/external-pointer.h
+++ b/src/sandbox/external-pointer.h
@@ -78,7 +78,13 @@
       "or update the NeedsCallbackRedirection specialization to support tag "
       "ranges.");
 
-  alignas(alignof(Tagged_t)) char storage_[sizeof(ExternalPointer_t)];
+  // Use natural alignment so MSVC's ABI honors V8_OBJECT's packing. An
+  // explicit alignas propagates through enclosing classes despite pack(4),
+  // adding tail padding that Torque counts but derived C++ fields can reuse.
+  union {
+    char storage_[sizeof(ExternalPointer_t)];
+    Tagged_t alignment_;
+  };
 };
 
