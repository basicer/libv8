--- a/src/objects/map.h
+++ b/src/objects/map.h
@@ -1289,7 +1289,10 @@
   static const int kStartOfStrongExtendedFieldsOffset;
 
   std::atomic<uint8_t> bit_field_ex_;
-  // Leaves kTaggedSize-1 unused bytes, they will be used by subclasses.
+  // Reserved rather than left as tail padding for subclasses: the MSVC ABI
+  // does not lower a base class's alignment for #pragma pack, so the implicit
+  // version of these bytes makes sizeof disagree with Torque's kSize.
+  uint8_t extended_base_padding_[kTaggedSize - 1];
 } V8_OBJECT_END;
 
 constexpr int ExtendedMapSizeForKind(ExtendedMapKind kind);
